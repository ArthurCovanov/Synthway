# Synthway Root .gitignore

# C / C++ Builds
build/
bin/
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
*.ilk
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile.bak
*.stackdump
compile_commands.json

# Temporary files and logs
*.tmp
*.temp
*.log
*.bak
*.orig
*.rej
*.lock
tmp/
temp/
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
# ...but not the UI's sources, which "lib/" would hide too
!synthway-ui/src/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
htmlcov/
.coverage
coverage.xml
pip-wheel-metadata/

# synthway-demucs: its environment, the downloaded weights (licence not clear:
# never committed) and the pieces decomposed; its lock file is kept
synthway-demucs/models/
synthway-demucs/work/
!synthway-demucs/uv.lock

# Node / React
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.parcel-cache/
.vite/
coverage/
*.tsbuildinfo
dist/
dist-ssr/
*.local

# Local configuration and secrets
.env
.env.*
!.env.example
!.env.sample

# Audio recordings and generated captures
recording/
recordings/
**/recording/
**/recordings/
*.recording.*
*.recorded.*
*-recording.*
*-recorded.*
*_recording.*
*_recorded.*

# IDEs & System
.vscode/
.idea/
.history/
.fleet/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Other
How2Launch.txt